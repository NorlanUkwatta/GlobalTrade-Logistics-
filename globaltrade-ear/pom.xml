<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.globaltrade.logistics</groupId>
        <artifactId>GlobalTradeLogistics</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>globaltrade-ear</artifactId>
    <packaging>ear</packaging>
    <name>GlobalTrade Logistics – EAR Assembly</name>
    <description>
        Enterprise Archive: assembles the EJB jar + WAR + all shared library JARs into
        a single deployable .ear for GlassFish 8.0.3. Shared libraries go to EAR/lib/
        so both the EJB and WAR classloaders see them through EAR parent delegation.
    </description>

    <dependencies>

        <!-- ── Application Modules ── -->
        <dependency>
            <groupId>com.globaltrade.logistics</groupId>
            <artifactId>globaltrade-ejb</artifactId>
            <type>ejb</type>
        </dependency>
        <dependency>
            <groupId>com.globaltrade.logistics</groupId>
            <artifactId>globaltrade-web</artifactId>
            <type>war</type>
        </dependency>

        <!--
            ══════════════════════════════════════════════════════════════
             SHARED LIBRARY JARs — compile scope → bundled in EAR/lib/
             Available to both globaltrade-ejb.jar and globaltrade-web.war
             via EAR parent classloader delegation.
            ══════════════════════════════════════════════════════════════
        -->

        <!-- Hibernate ORM 6 (JPA provider — GlassFish uses EclipseLink by default,
             we override with Hibernate declared in persistence.xml) -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
        </dependency>

        <!-- JJWT 0.12 — API + runtime implementations -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
        </dependency>

        <!-- Log4j 2 — structured enterprise logging -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
        </dependency>

        <!-- BCrypt — secure password hashing -->
        <dependency>
            <groupId>org.mindrot</groupId>
            <artifactId>jbcrypt</artifactId>
        </dependency>

        <!--
            NOTE: MySQL connector-j is NOT included here.
            It must be placed in: <GLASSFISH_HOME>/domains/domain1/lib/
            This is required for GlassFish's JTA connection pool to find
            the JDBC driver outside the application classloader.
        -->

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-ear-plugin</artifactId>
                <configuration>
                    <!-- Jakarta EE 10 application version -->
                    <version>8</version>
                    <!-- All non-module compile JARs land here -->
                    <defaultLibBundleDir>lib</defaultLibBundleDir>
                    <modules>
                        <ejbModule>
                            <groupId>com.globaltrade.logistics</groupId>
                            <artifactId>globaltrade-ejb</artifactId>
                            <bundleFileName>globaltrade-ejb.jar</bundleFileName>
                        </ejbModule>
                        <webModule>
                            <groupId>com.globaltrade.logistics</groupId>
                            <artifactId>globaltrade-web</artifactId>
                            <bundleFileName>globaltrade-web.war</bundleFileName>
                            <contextRoot>/globaltrade</contextRoot>
                        </webModule>
                    </modules>
                    <!-- application.xml is auto-generated from above config -->
                    <generateApplicationXml>true</generateApplicationXml>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>