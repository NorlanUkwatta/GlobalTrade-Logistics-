<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE glassfish-web-app PUBLIC
    "-//GlassFish.org//DTD GlassFish Application Server 3.1 Servlet 3.0//EN"
    "http://glassfish.org/dtds/glassfish-web-app_3_0-1.dtd">

<glassfish-web-app error-url="/WEB-INF/errors/500.jsp">
    <security-role-mapping>
        <role-name>ADMIN</role-name>
        <group-name>ADMIN</group-name>
    </security-role-mapping>
    <security-role-mapping>
        <role-name>LOGISTICS_COORD</role-name>
        <group-name>LOGISTICS_COORD</group-name>
    </security-role-mapping>
    <security-role-mapping>
        <role-name>WAREHOUSE_MGR</role-name>
        <group-name>WAREHOUSE_MGR</group-name>
    </security-role-mapping>
    <security-role-mapping>
        <role-name>VENDOR_REP</role-name>
        <group-name>VENDOR_REP</group-name>
    </security-role-mapping>
    <security-role-mapping>
        <role-name>CUSTOMS_AGENT</role-name>
        <group-name>CUSTOMS_AGENT</group-name>
    </security-role-mapping>
    <security-role-mapping>
        <role-name>CUSTOMER</role-name>
        <group-name>CUSTOMER</group-name>
    </security-role-mapping>
    <security-role-mapping>
        <role-name>OPS</role-name>
        <group-name>OPS</group-name>
    </security-role-mapping>
    <security-role-mapping>
        <role-name>ITOPS</role-name>
        <group-name>ITOPS</group-name>
    </security-role-mapping>
    <class-loader delegate="true"/>
</glassfish-web-app>
