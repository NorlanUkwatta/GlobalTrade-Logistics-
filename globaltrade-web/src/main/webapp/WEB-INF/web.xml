<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee" version="6.0">
    <display-name>GlobalTrade Logistics Supply Chain Portal</display-name>
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <name>GTLSESSIONID</name>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>
    <security-role>
        <description>Platform administrator</description>
        <role-name>ADMIN</role-name>
    </security-role>
    <security-role>
        <description>Internal logistics coordinator</description>
        <role-name>LOGISTICS_COORD</role-name>
    </security-role>
    <security-role>
        <description>Internal warehouse manager</description>
        <role-name>WAREHOUSE_MGR</role-name>
    </security-role>
    <security-role>
        <description>External vendor representative</description>
        <role-name>VENDOR_REP</role-name>
    </security-role>
    <security-role>
        <description>External customs official</description>
        <role-name>CUSTOMS_AGENT</role-name>
    </security-role>
    <security-role>
        <description>End customer</description>
        <role-name>CUSTOMER</role-name>
    </security-role>
    <security-role>
        <description>Operations Team</description>
        <role-name>OPS</role-name>
    </security-role>
    <jsp-config>
        <jsp-property-group>
            <url-pattern>*.jsp</url-pattern>
            <page-encoding>UTF-8</page-encoding>
            <include-prelude>/WEB-INF/jspf/header.jspf</include-prelude>
            <include-coda>/WEB-INF/jspf/footer.jspf</include-coda>
            <default-content-type>text/html</default-content-type>
            <buffer>8kb</buffer>
        </jsp-property-group>
    </jsp-config>
    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/errors/403.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/errors/404.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/errors/500.jsp</location>
    </error-page>



</web-app>